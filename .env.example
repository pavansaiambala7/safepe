# ── Razorpay Payment Gateway ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourSecretHere        # required
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere  # required

# ── Gemini AI (Fraud Detection + Embeddings) ────────────────────────────────
GEMINI_API_KEY=YourGeminiApiKeyHere       # required

# ── Clerk Authentication (Frontend + Backend) ───────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YourClerkPublishableKeyHere
CLERK_SECRET_KEY=sk_test_YourClerkSecretKeyHere

# ── Kafka Event Bus ─────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Redis Vector Cache ──────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Database ────────────────────────────────────────────────────────────────
# Required. docker compose refuses to start without it.
POSTGRES_USER=safepe_user
POSTGRES_PASSWORD=ChangeMeToSomethingLong
POSTGRES_DB=safepe_db

# ── Vite Frontend ───────────────────────────────────────────────────────────
# NOTE: VITE_API_URL was removed - no source file ever read it. The SPA calls
# the relative path /api/v1, which the frontend nginx proxies to api-gateway.
#
# VITE_* values are baked in at IMAGE BUILD time (docker-compose build args),
# not at container start. Changing one requires a rebuild:
#   docker compose build frontend && docker compose up -d frontend
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YourClerkPublishableKeyHere

# ── Gateway: CORS + Rate Limiting ───────────────────────────────────────────
# Only consulted for cross-origin callers. Set this to your public origin when
# the SPA is served from somewhere other than the bundled nginx.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_ENABLED=true
